new file mode 100644
index 0000000..9aec6d8
--- /dev/null
+++ b/src/qualification/fixtures.ts
@@ -0,0 +1,35 @@
+export type Category = 'fr-ca' | 'darija' | 'code-switch' | 'noise';
+export interface Fixture {
+  id: string;
+  category: Category;
+  reference: string;
+  condition: string | null;
+}
+
+export const thresholds: Record<Category, number> = {
+  'fr-ca': 0.15, darija: 0.25, 'code-switch': 0.25, noise: 0.30
+};
+
+/** The reviewed Markdown is the single source of fixture text. */
+export function parseFixtures(markdown: string): Fixture[] {
+  const fixtures: Fixture[] = [];
+  const groups = { FQ: ['fr-ca', 15], DJ: ['darija', 15], CS: ['code-switch', 10], NZ: ['noise', 10] } as const;
+  for (const line of markdown.split(/\r?\n/u)) {
+    const cells = line.split('|').map(cell => cell.trim());
+    const match = /^(FQ|DJ|CS|NZ)(\d{2})$/u.exec(cells[1] ?? '');
+    if (!match) continue;
+    const prefix = match[1] as keyof typeof groups;
+    const [category, count] = groups[prefix];
+    const number = Number(match[2]);
+    const noise = prefix === 'NZ';
+    const reference = cells[noise ? 4 : 3];
+    if (number < 1 || number > count || !reference || cells.length !== (noise ? 6 : 5)) {
+      throw new Error('INVALID_FIXTURE_ROW');
+    }
+    if (fixtures.some(f => f.id === cells[1])) throw new Error('DUPLICATE_FIXTURE');
+    fixtures.push({ id: cells[1], category, reference,
+      condition: noise ? `${cells[2]} — ${cells[3]}` : null });
+  }
+  if (fixtures.length !== 50) throw new Error('EXPECTED_50_FIXTURES');
+  return fixtures;
+}
diff --git a/src/qualification/wav.ts b/src/qualification/wav.ts
new file mode 100644
index 0000000..07acace
--- /dev/null
+++ b/src/qualification/wav.ts
@@ -0,0 +1,62 @@
+import { createHash } from 'node:crypto';
+
+export const MAX_WAV_BYTES = 12 * 1024 * 1024;
+export const sha256 = (bytes: Uint8Array | string): string => createHash('sha256').update(bytes).digest('hex');
+
+/** Strict PCM16 reader: checks boundaries, padding, format and non-empty audio. */
+export function inspectWav(bytes: Buffer) {
+  if (bytes.length < 44 || bytes.length > MAX_WAV_BYTES) throw new Error('WAV_SIZE');
+  if (bytes.toString('ascii', 0, 4) !== 'RIFF' || bytes.toString('ascii', 8, 12) !== 'WAVE') {
+    throw new Error('WAV_CONTAINER');
+  }
+  if (bytes.readUInt32LE(4) + 8 !== bytes.length) throw new Error('WAV_TRUNCATED_OR_TRAILING');
+  let format: Buffer | undefined;
+  let data: Buffer | undefined;
+  let offset = 12;
+  while (offset < bytes.length) {
+    if (offset + 8 > bytes.length) throw new Error('WAV_CHUNK_HEADER');
+    const id = bytes.toString('ascii', offset, offset + 4);
+    const size = bytes.readUInt32LE(offset + 4);
+    const start = offset + 8;
+    const end = start + size;
+    const next = end + (size % 2);
+    if (next > bytes.length) throw new Error('WAV_CHUNK_TRUNCATED');
+    if (id === 'fmt ') {
+      if (format) throw new Error('WAV_DUPLICATE_FORMAT');
+      format = bytes.subarray(start, end);
+    }
+    if (id === 'data') {
+      if (data) throw new Error('WAV_DUPLICATE_DATA');
+      data = bytes.subarray(start, end);
+    }
+    offset = next;
+  }
+  if (!format || format.length < 16 || !data || data.length === 0) throw new Error('WAV_MISSING_AUDIO');
+  const codec = format.readUInt16LE(0);
+  const channels = format.readUInt16LE(2);
+  const sampleRateHz = format.readUInt32LE(4);
+  const byteRate = format.readUInt32LE(8);
+  const blockAlign = format.readUInt16LE(12);
+  const bits = format.readUInt16LE(14);
+  if (codec !== 1 || channels !== 1 || bits !== 16 || ![16000, 44100].includes(sampleRateHz)) {
+    throw new Error('WAV_EXPECTED_PCM16_MONO_16000_OR_44100');
+  }
+  if (blockAlign !== 2 || byteRate !== sampleRateHz * 2 || data.length % 2) throw new Error('WAV_ALIGNMENT');
+  const durationMs = data.length / byteRate * 1000;
+  if (durationMs < 100 || durationMs > 120000) throw new Error('WAV_DURATION');
+  let peak = 0;
+  let squared = 0;
+  let clipped = 0;
+  for (let i = 0; i < data.length; i += 2) {
+    const sample = Math.abs(data.readInt16LE(i));
+    peak = Math.max(peak, sample);
+    squared += sample * sample;
+    if (sample >= 32767) clipped++;
+  }
+  if (peak === 0) throw new Error('WAV_DIGITAL_SILENCE');
+  return {
+    sha256: sha256(bytes), bytes: bytes.length, sampleRateHz, channels, bits, durationMs,
+    peak, rms: Math.sqrt(squared / (data.length / 2)), clippedSamples: clipped,
+    humanListeningRequired: true as const
+  };
+}
diff --git a/src/qualification/wer.ts b/src/qualification/wer.ts
new file mode 100644
index 0000000..4234e61
--- /dev/null
+++ b/src/qualification/wer.ts
@@ -0,0 +1,41 @@
+export const NORMALIZATION_VERSION = 'p0-fixtures-v1';
+
+/** Deliberately narrow, published number lexicon for the locked FQ10/DJ10 corpus.
+ * No translation, accent stripping or Arabic letter folding is performed.
+ */
+export function normalizeForWer(text: string): string[] {
+  const normalized = text.normalize('NFKC').toLowerCase()
+    .replace(/[٠-٩]/gu, digit => String(digit.charCodeAt(0) - 0x660))
+    .replace(/[۰-۹]/gu, digit => String(digit.charCodeAt(0) - 0x6f0))
+    .replace(/\p{P}/gu, ' ').trim();
+  if (!normalized) return [];
+  return normalized.split(/\s+/u).map(word => ['dix', 'عشرة', 'العشرة'].includes(word) ? '10' : word);
+}
+
+export function wordErrorRate(reference: string, hypothesis: string) {
+  const ref = normalizeForWer(reference);
+  const hyp = normalizeForWer(hypothesis);
+  if (!ref.length || ref.length > 2000 || hyp.length > 2000) throw new Error('WER_TOKEN_LIMIT');
+  type Cell = { substitutions: number; deletions: number; insertions: number; errors: number };
+  let previous: Cell[] = Array.from({ length: hyp.length + 1 }, (_, n) =>
+    ({ substitutions: 0, deletions: 0, insertions: n, errors: n }));
+  for (let i = 1; i <= ref.length; i++) {
+    const current: Cell[] = [{ substitutions: 0, deletions: i, insertions: 0, errors: i }];
+    for (let j = 1; j <= hyp.length; j++) {
+      if (ref[i - 1] === hyp[j - 1]) { current.push(previous[j - 1]); continue; }
+      const sub = previous[j - 1];
+      const del = previous[j];
+      const ins = current[j - 1];
+      // Stable tie break: substitution, deletion, insertion.
+      const candidates = [
+        { ...sub, substitutions: sub.substitutions + 1, errors: sub.errors + 1 },
+        { ...del, deletions: del.deletions + 1, errors: del.errors + 1 },
+        { ...ins, insertions: ins.insertions + 1, errors: ins.errors + 1 }
+      ];
+      current.push(candidates.reduce((best, cell) => cell.errors < best.errors ? cell : best));
+    }
+    previous = current;
+  }
+  return { ...previous[hyp.length], referenceWords: ref.length, hypothesisWords: hyp.length,
+    wer: previous[hyp.length].errors / ref.length };
+}
diff --git a/tests/qualification.test.ts b/tests/qualification.test.ts
